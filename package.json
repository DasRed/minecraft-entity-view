{
    "name": "@dasred/minecraft-entity-view",
    "packageManager": "npm@11.6.2",
    "version": "1.16.4",
    "description": "Live map and statistics of all entities on a Minecraft server in the browser.",
    "keywords": [
        "minecraft",
        "neoforge",
        "entities",
        "map",
        "leaflet",
        "websocket",
        "react"
    ],
    "private": true,
    "type": "module",
    "author": "Marco Starker",
    "license": "MIT",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "bugs": {
        "url": "https://github.com/DasRed/minecraft-entity-view/issues"
    },
    "homepage": "https://www.marco-starker.de/en/projects/minecraft-entity-view/docs",
    "engines": {
        "node": ">=26.12.1",
        "npm": ">=11.20.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/DasRed/minecraft-entity-view.git"
    },
    "scripts": {
        "dev": "turbo run dev --parallel",
        "build": "turbo run build",
        "start": "turbo run start",
        "wsc": "wsc -C ws://localhost:7791"
    },
    "dependencies": {
        "turbo": "^2.6.3",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "wsc": "^0.3.0"
    }
}
