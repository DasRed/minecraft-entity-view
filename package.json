{
    "name": "@dasred/minecraft-entity-view",
    "packageManager": "npm@11.6.2",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "author": "Marco Starker",
    "license": "MIT",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "bugs": {
        "url": "https://github.com/DasRed/minecraft-entity-view/issues"
    },
    "homepage": "https://github.com/DasRed/minecraft-entity-view",
    "engines": {
        "node": ">=25.0.0",
        "npm": ">=11.6.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/DasRed/minecraft-entity-view.git"
    },
    "scripts": {
        "dev": "turbo run dev --parallel",
        "build": "turbo run build",
        "start": "turbo run start",
        "semantic-release": "semantic-release",
        "wsc": "wsc -C ws://localhost:7791"
    },
    "devDependencies": {
        "@saithodev/semantic-release-backmerge": "^4.0.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.0",
        "@semantic-release/npm": "^13.0.0",
        "semantic-release": "^25.0.0",
        "semantic-release-cli": "^5.4.6",
        "turbo": "^2.6.3",
        "typescript": "^5.9.3",
        "wsc": "^0.3.0"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "package-lock.json"
                    ]
                }
            ],
            "@semantic-release/github",
            [
                "@saithodev/semantic-release-backmerge",
                {
                    "backmergeBranches": [
                        {
                            "from": "main",
                            "to": "develop"
                        }
                    ],
                    "backmergeStrategy": "merge",
                    "mergeMode": "theirs"
                }
            ]
        ]
    }
}
