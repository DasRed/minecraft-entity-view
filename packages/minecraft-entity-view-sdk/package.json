{
    "name": "@dasred/minecraft-entity-view-sdk",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "author": "Marco Starker",
    "license": "MIT",
    "exports": {
        "./constant/*": {
            "types": "./src/constant/*.ts",
